  "governing": [
    {
      "number": "12.9",
      "purpose": "Еквівалентна амплітуда за прийнятим лінійним Goodman, без кредитування стискального середнього напруження.",
      "formula": "σeq = Kf σa / (1 − Kf max(σm,0)/σu)",
      "symbols": "Kf — прийнятий коефіцієнт концентрації; σa, σm — амплітуда і середнє напруження, Па; σu — межа міцності, Па. Знаменник має бути додатним."
    },
    {
      "number": "12.10",
      "purpose": "Ресурс визначається інтерполяцією лише між двома введеними S–N опорами.",
      "formula": "b = ln(σ₂/σ₁)/ln(N₂/N₁); N = N₁ (σeq/σ₁)^(1/b); t = N/(30n)",
      "symbols": "N₁, N₂ — задані числа циклів; σ₁, σ₂ — їхні амплітуди, Па; n — частота двигуна, хв⁻¹; t — умовна тривалість, год. Один блок — обраний цикл 360° або 720°, не спектр навантаження. За межами опор точне N не повертається."
    }
  ]
